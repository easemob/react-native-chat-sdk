{
  "name": "react-native-chat-sdk",
  "version": "1.18.0",
  "description": "An instant messaging SDK product is a software development kit that provides interfaces and functionalities for building and integrating real-time messaging features, enabling developers to implement instant messaging services within their applications.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-chat-sdk-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "modules/cpp/**",
    "modules/java/**",
    "modules/objc/**",
    "modules/cpp/CMakeLists.txt",
    "scripts/generate-cmake.js",
    "scripts/generate-version.js",
    "scripts/generate-env.js",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!CHANGELOG.md",
    "!CHANGELOG.zh.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-chat-sdk-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "yarn run gen:version_file && yarn run gen:cmake_file && yarn run gen:env_file && bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "test:unit": "jest src/__tests__/unit",
    "test:contract": "jest src/__tests__/contract",
    "test:coverage": "jest --coverage",
    "scan:deprecated": "bash scripts/scan-deprecated.sh",
    "scan:deprecated:android": "bash scripts/scan-deprecated-android.sh",
    "scan:deprecated:ios": "bash scripts/scan-deprecated-ios.sh",
    "gen:env_file": "cd scripts && node generate-env.js",
    "gen:version_file": "cd scripts && node generate-version.js",
    "gen:cmake_file": "cd scripts && node generate-cmake.js",
    "check:circular:dpdm": "dpdm --circular --transform --include ts src/",
    "check:circular:madge": "madge --circular --extensions ts src/",
    "doc": "node ./scripts/docs/build_api_docs.js",
    "doc:md": "mkdir -p ./docs/build/md && yarn exec typedoc --plugin typedoc-plugin-markdown --out ./docs/build/md --tsconfig ./tsconfig.json --readme ./docs/rn_api_overview.md ./src/index.ts",
    "doc:agora:update": "node ./scripts/update_api_docs.js 1.4.0 undefined agora en",
    "doc:shengwang:update": "node ./scripts/update_api_docs.js 1.4.0 undefined shengwang en",
    "hooks:install": "lefthook install -f",
    "hooks:repair": "node ./scripts/repair-lefthook-hooks.js",
    "release": "release-it --only-version",
    "web": "vite",
    "build:web": "vite build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsteriskZuo/react-native-chat-sdk.git"
  },
  "author": "asteriskzuo <zuoyuhsywn@hotmail.com> (https://github.com/AsteriskZuo)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AsteriskZuo/react-native-chat-sdk/issues"
  },
  "homepage": "https://github.com/AsteriskZuo/react-native-chat-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/jest": "^28.1.2",
    "@types/react": "^19.2.0",
    "commitlint": "^21.0.2",
    "del-cli": "^7.0.0",
    "dpdm": "^4.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "lefthook": "^2.1.9",
    "madge": "^8.0.0",
    "prettier": "^3.8.3",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-builder-bob": "^0.41.0",
    "react-native-web": "~0.21.2",
    "release-it": "^20.2.0",
    "turbo": "^2.9.16",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": ">=24"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNChatSdkSpec",
    "type": "modules",
    "jsSrcsDir": "src/__specs__",
    "android": {
      "javaPackageName": "com.chatsdk"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "<%- project.sourceCondition -%>"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/__tests__/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/.worktree/",
      "<rootDir>/src/__tests__/helpers/",
      "<rootDir>/src/__tests__/setup.ts",
      "<rootDir>/src/__tests__/contract/parsers.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/__specs__/**",
      "!src/__tests__/**",
      "!src/version.ts",
      "!src/index.ts"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "build",
          "chore",
          "ci",
          "docs",
          "feat",
          "fix",
          "perf",
          "refactor",
          "revert",
          "style",
          "test",
          "tag",
          "api",
          "example"
        ]
      ]
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it",
      "vite"
    ],
    "version": "0.63.0"
  }
}
