{
  "_comment": "5.0.0 平版新增/修改 API 正向路径（auto 模式）。数据源为 env.ts（yarn env:gettoken 生成）。辅助步骤 sendMessage/destroyGroup 仅用于准备与清理，不计入被测 API。modifyMsgBody 按公开契约期待成功；未开通消息编辑服务的集群会返回 305，并由报告如实标记为环境限制。kickDevice 使用 getLoggedInDevicesFromServer 返回的真实 resource，会踢掉当前设备，因此与 kickAllDevices 固定放在最后。单账号只验证回执 API 的成功调用；非空回执、onMessageReadReceipts 与 ChatGroupMemberInfo 暂不覆盖。",
  "steps": [
    {
      "api": "ChatManager.getUnreadCount",
      "id": "unread_before",
      "params": {},
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.sendMessage",
      "id": "msg_self",
      "params": {
        "targetId": "$config.accounts.0.id",
        "content": "port-5.0.0 positive self-chat",
        "chatType": 0
      },
      "delayAfterMs": 1000,
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.modifyMsgBody",
      "id": "modify_self",
      "params": {
        "msgId": "$step.msg_self.msgId",
        "content": "port-5.0.0 positive self-chat (modified)",
        "ext": { "port": "5.0.0", "path": "positive" }
      },
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.clearConversationUnreadMessageCount",
      "id": "clear_conv",
      "params": { "convId": "$config.accounts.0.id" },
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.clearAllConversationUnreadMessageCount",
      "id": "clear_all",
      "params": {},
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.getUnreadCount",
      "id": "unread_after",
      "params": {},
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.getAllConversations",
      "id": "convs",
      "params": {},
      "expect": { "success": true }
    },
    {
      "api": "ChatGroupManager.createGroupEx",
      "id": "grp",
      "params": {
        "groupName": "rn-port-500-positive",
        "desc": "5.0.0 positive-path verification",
        "configs": {
          "maxCount": 200,
          "inviteNeedConfirm": false,
          "ext": "",
          "isPublic": false,
          "joinApprovalRequired": false,
          "allowInvites": true
        }
      },
      "expect": { "success": true }
    },
    {
      "api": "ChatGroupManager.updateGroupConfigs",
      "id": "grp_update",
      "params": {
        "groupId": "$step.grp.groupId",
        "types": 34,
        "configs": {
          "maxCount": 300,
          "inviteNeedConfirm": false,
          "ext": "rn-port-500-positive",
          "isPublic": false,
          "joinApprovalRequired": false,
          "allowInvites": true
        }
      },
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.sendMessage",
      "id": "gmsg",
      "params": {
        "targetId": "$step.grp.groupId",
        "content": "port-5.0.0 positive group receipt",
        "chatType": 1,
        "isNeedReadReceipt": true
      },
      "delayAfterMs": 1000,
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.getGroupMessageReadReceipts",
      "id": "grp_receipts_local",
      "params": { "msgIds": ["$step.gmsg.msgId"] },
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.fetchGroupMessageReadReceipts",
      "id": "grp_receipts_server",
      "params": {
        "msgId": "$step.gmsg.msgId",
        "groupId": "$step.grp.groupId",
        "pageSize": 20
      },
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.sendMessageReadReceipts",
      "id": "receipt_group",
      "params": { "msgIds": ["$step.gmsg.msgId"] },
      "expect": { "success": true }
    },
    {
      "api": "ChatClient.getLoggedInDevicesFromServer",
      "id": "devices",
      "params": {
        "userId": "$config.accounts.0.id",
        "token": "$config.accounts.0.mm"
      },
      "expect": { "success": true }
    },
    {
      "api": "ChatClient.renewToken",
      "id": "renew",
      "params": { "token": "$config.accounts.0.mm" },
      "expect": { "success": true }
    },
    {
      "api": "ChatGroupManager.destroyGroup",
      "id": "grp_destroy",
      "params": { "groupId": "$step.grp.groupId" },
      "expect": { "success": true }
    },
    {
      "api": "ChatClient.kickDevice",
      "id": "kick_current_device",
      "params": {
        "userId": "$config.accounts.0.id",
        "token": "$config.accounts.0.mm",
        "resource": "$step.devices.0.resource"
      },
      "expect": { "success": true }
    },
    {
      "api": "ChatClient.kickAllDevices",
      "id": "kick_all",
      "params": {
        "userId": "$config.accounts.0.id",
        "token": "$config.accounts.0.mm"
      },
      "expect": { "success": true }
    }
  ]
}
