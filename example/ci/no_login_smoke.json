{
  "init": { "appKey": "easemob-demo#zuoyu" },
  "login": false,
  "steps": [
    {
      "api": "ChatManager.searchMessagesFromServer",
      "id": "chat.searchMessagesFromServer",
      "params": { "keywordList": ["rn-ci"], "pageSize": 10, "pageNum": 1 },
      "expect": { "errorCode": 201 }
    },
    {
      "api": "ChatContactManager.addContact",
      "id": "contact.addContact",
      "params": { "userId": "rn-ci-nonexistent-user", "reason": "rn-ci" },
      "expect": { "errorCode": 201 }
    },
    {
      "api": "ChatGroupManager.getJoinedGroups",
      "id": "group.getJoinedGroups",
      "params": {},
      "expect": { "success": true }
    },
    {
      "api": "ChatRoomManager.fetchPublicChatRoomsFromServer",
      "id": "room.fetchPublicChatRoomsFromServer",
      "params": { "pageNum": 1, "pageSize": 20 },
      "expect": { "errorCode": 201 }
    },
    {
      "api": "ChatPresenceManager.publishPresence",
      "id": "presence.publishPresence",
      "params": { "description": "rn-ci" },
      "expect": { "errorCode": 201 }
    },
    {
      "api": "ChatPushManager.fetchSilentModeForAll",
      "id": "push.fetchSilentModeForAll",
      "params": {},
      "expect": { "errorCode": 201 }
    },
    {
      "api": "ChatUserInfoManager.fetchSubscribedUsers",
      "id": "userInfo.fetchSubscribedUsers",
      "params": {},
      "expect": { "errorCode": 201 }
    }
  ]
}
