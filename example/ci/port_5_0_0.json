{
  "_comment": "5.0.0 平版 新增/修改 API 登录态验证脚本（auto 模式）。数据源为打包进来的 env.ts（yarn env:gettoken 生成）。覆盖：已读回执体系 4 个新 API、未读数 2 个新 API + getUnreadCount、modifyMsgBody(ext)、createGroupEx(configs)/updateGroupConfigs、设备管理 token 鉴权三方法、renewToken，以及 3 个不存在消息的错误路径。登录事件（onDataSyncStart/onDataSyncFinish/onDatabaseOpened）与会话 displayName/displayAvatar 由报告器核对。注意：modifyMsgBody 预期 305（ngi 集群未开通消息编辑服务，SERVER_SERVICE_RESTRICTED，能拿到服务端业务错误即证明链路正确）；kickDevice 对不存在的 resource 服务端返回成功；kickAllDevices 会踢掉本端，固定放最后。单账号限制：已读回执只能对自己发的消息调用，onMessageReadReceipts 事件与 ChatGroupMemberInfo 需双账号验证。",
  "steps": [
    {
      "api": "ChatManager.getUnreadCount",
      "id": "unread_before",
      "params": {},
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.sendMessage",
      "id": "msg_self",
      "params": {
        "targetId": "$config.accounts.0.id",
        "content": "port-5.0.0 self-chat",
        "chatType": 0
      },
      "delayAfterMs": 1000,
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.modifyMsgBody",
      "id": "modify_self",
      "params": {
        "msgId": "$step.msg_self.msgId",
        "content": "port-5.0.0 self-chat (modified)",
        "ext": { "port": "5.0.0" }
      },
      "expect": { "errorCode": 305 }
    },
    {
      "api": "ChatManager.clearConversationUnreadMessageCount",
      "id": "clear_conv",
      "params": { "convId": "$config.accounts.0.id" },
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.clearAllConversationUnreadMessageCount",
      "id": "clear_all",
      "params": {},
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.getUnreadCount",
      "id": "unread_after",
      "params": {},
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.getAllConversations",
      "id": "convs",
      "params": {},
      "expect": { "success": true }
    },
    {
      "api": "ChatGroupManager.createGroupEx",
      "id": "grp",
      "params": {
        "groupName": "rn-port-500",
        "desc": "5.0.0 porting verification",
        "configs": {
          "maxCount": 200,
          "inviteNeedConfirm": false,
          "ext": "",
          "isPublic": false,
          "joinApprovalRequired": false,
          "allowInvites": true
        }
      },
      "expect": { "success": true }
    },
    {
      "api": "ChatGroupManager.updateGroupConfigs",
      "id": "grp_update",
      "params": {
        "groupId": "$step.grp.groupId",
        "types": 34,
        "configs": {
          "maxCount": 300,
          "inviteNeedConfirm": false,
          "ext": "rn-port-500",
          "isPublic": false,
          "joinApprovalRequired": false,
          "allowInvites": true
        }
      },
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.sendMessage",
      "id": "gmsg",
      "params": {
        "targetId": "$step.grp.groupId",
        "content": "port-5.0.0 group receipt",
        "chatType": 1,
        "isNeedReadReceipt": true
      },
      "delayAfterMs": 1000,
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.getGroupMessageReadReceipts",
      "id": "grp_receipts_local",
      "params": { "msgIds": ["$step.gmsg.msgId"] },
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.fetchGroupMessageReadReceipts",
      "id": "grp_receipts_server",
      "params": {
        "msgId": "$step.gmsg.msgId",
        "groupId": "$step.grp.groupId",
        "pageSize": 20
      },
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.sendMessageReadReceipts",
      "id": "receipt_group",
      "params": { "msgIds": ["$step.gmsg.msgId"] },
      "expect": { "success": true }
    },
    {
      "api": "ChatClient.getLoggedInDevicesFromServer",
      "id": "devices",
      "params": {
        "userId": "$config.accounts.0.id",
        "token": "$config.accounts.0.mm"
      },
      "expect": { "success": true }
    },
    {
      "api": "ChatClient.renewToken",
      "id": "renew",
      "params": { "token": "$config.accounts.0.mm" },
      "expect": { "success": true }
    },
    {
      "api": "ChatClient.kickDevice",
      "id": "kick_bogus",
      "params": {
        "userId": "$config.accounts.0.id",
        "token": "$config.accounts.0.mm",
        "resource": "rn-ci-nonexistent-resource"
      },
      "expect": { "success": true }
    },
    {
      "api": "ChatGroupManager.destroyGroup",
      "id": "grp_destroy",
      "params": { "groupId": "$step.grp.groupId" },
      "expect": { "success": true }
    },
    {
      "api": "ChatManager.sendMessageReadReceipts",
      "id": "receipt_missing",
      "params": { "msgIds": ["not-exist-msg-id-500"] },
      "expect": { "success": false }
    },
    {
      "api": "ChatManager.getGroupMessageReadReceipts",
      "id": "group_receipt_missing",
      "params": { "msgIds": ["not-exist-group-msg-id-500"] },
      "expect": { "success": false }
    },
    {
      "api": "ChatManager.fetchGroupMessageReadReceipts",
      "id": "fetch_group_receipt_missing",
      "params": {
        "msgId": "not-exist-group-msg-id-500",
        "groupId": "$step.grp.groupId",
        "cursor": "",
        "pageSize": 20
      },
      "expect": { "success": false }
    },
    {
      "api": "ChatClient.kickAllDevices",
      "id": "kick_all",
      "params": {
        "userId": "$config.accounts.0.id",
        "token": "$config.accounts.0.mm"
      },
      "expect": { "success": true }
    }
  ]
}
